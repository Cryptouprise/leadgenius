# Supabase Configuration
# Get these from your Supabase project settings (https://supabase.com)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_PROJECT_ID=your-project-id

# Millis Voice AI Configuration
# Sign up at https://millis.ai to get your API key
VITE_MILLIS_API_KEY=your-millis-api-key-here

# Base Path Configuration
# Set this if deploying to a subdirectory (e.g., /app)
# Leave as / for root deployment
VITE_BASE_PATH=/

# Tempo Development Tools (Optional)
# Set to true to enable Tempo development tools
VITE_TEMPO=false

# Environment
NODE_ENV=development
